# ==============================================================================
# SERVICE BOOKING PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (supports comma-separated list in production)
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# MySQL Database Connection (Prisma)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
DATABASE_URL="mysql://root:password@localhost:3306/service_booking_db"

# JWT Authentication & Authorization
# Generate a cryptographically secure random string with at least 32 characters
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (frontend/.env.local)
# ------------------------------------------------------------------------------
# Base URL for the Express backend REST API
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
