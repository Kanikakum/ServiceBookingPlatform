# ==============================================================================
# SERVICE BOOKING PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (supports comma-separated list in production)
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# MySQL Database Connection (Prisma)
# Local Development Format:
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/service_booking_db"
#
# Production (Aiven MySQL with SSL):
# Note: For Prisma 5.x MySQL connector, SSL is configured via `sslaccept` and `sslcert`.
# Option 1 (Strict validation with Aiven CA certificate downloaded from Aiven console):
# Place ca.pem in backend/prisma/ca.pem (paths in sslcert are resolved relative to backend/prisma/):
# DATABASE_URL="mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?sslaccept=strict&sslcert=ca.pem"
#
# Option 2 (TLS encrypted connection without local CA cert file):
# DATABASE_URL="mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?sslaccept=accept_invalid_certs"
#
# Reminder: If the database password contains special characters, URL-encode them (e.g. @ -> %40).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/service_booking_db"

# JWT Authentication & Authorization
# Generate a cryptographically secure random string with at least 32 characters
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (frontend/.env.local)
# ------------------------------------------------------------------------------
# Base URL for the Express backend REST API
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
