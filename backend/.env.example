PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Database Connection (Aiven MySQL requires SSL)
# Option 1 (Strict with CA cert in backend/prisma/ca.pem): mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict&sslcert=ca.pem
# Option 2 (Encrypted TLS without local cert): mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=accept_invalid_certs
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/service_booking_db"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"
