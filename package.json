{
  "name": "service-booking-platform",
  "version": "1.0.0",
  "description": "Production-ready Service Booking Platform monorepo",
  "private": true,
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "test:backend": "npm --prefix backend run test",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate"
  },
  "keywords": [
    "nextjs",
    "express",
    "prisma",
    "mysql",
    "booking-system",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC"
}
